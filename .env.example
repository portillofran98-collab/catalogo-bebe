# Copia este archivo a .env.local y completa los valores.

# Usuario de Instagram de la tienda, sin @. Se usa en el footer y en los botones de pedido.
NEXT_PUBLIC_INSTAGRAM_USER=

# URL pública del sitio (en local: http://localhost:3000; en Vercel: la URL de producción).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
